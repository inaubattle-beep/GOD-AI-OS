# GOD AI OS - Environment Configuration

# System & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=god-ai-os-super-secret-key-change-in-production-32bytes

# API Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL + pgvector)
POSTGRES_USER=god_user
POSTGRES_PASSWORD=god_password
POSTGRES_DB=god_ai_os
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://god_user:god_password@localhost:5432/god_ai_os

# Redis & Task Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Model Provider API Keys (Optional/Configurable)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Vector DB Backend Configuration (pgvector | qdrant | chroma)
VECTOR_STORE_PROVIDER=pgvector

# MCP Gateway Settings
MCP_SERVER_TIMEOUT=30
